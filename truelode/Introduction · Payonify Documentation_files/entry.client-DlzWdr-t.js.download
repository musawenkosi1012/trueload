      /* Hide "Header Request" section in playground response panel */
      .h-\\[80vh\\] > [data-state]:has(.lucide-corner-down-right) {
        display: none !important;
      }

      /* Playground login dialog — hide Skip button and close X button */
      [role="dialog"]:has(.sm\\:justify-between) .sm\\:justify-between > button:first-child,
      [role="dialog"]:has(.sm\\:justify-between) > button.absolute {
        display: none !important;
      }

      /* Disable Send button when not authenticated */
      body:not(.pn-authenticated) button[type="submit"].w-18 {
        pointer-events: none;
        opacity: 0.5;
      }
