# Copy to .env and adjust.
FLASK_ENV=development
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-jwt-secret

# SQLite for zero-setup demo; swap to Postgres for pilot:
# DATABASE_URL=postgresql+psycopg2://truelode:truelode@localhost:5432/truelode
DATABASE_URL=sqlite:///truelode.db

# Reconciliation defaults (overridable per route/processor)
WEIGHT_TOLERANCE_PCT=2.0
GRADE_TOLERANCE_PCT=5.0
CORRIDOR_BUFFER_M=500
STOP_DWELL_MIN=15

# Passport signing key path (auto-generated on first run if missing)
PASSPORT_KEY_PATH=passport_key.pem

# S3/MinIO for photos (optional; falls back to local ./uploads)
S3_ENDPOINT=
S3_BUCKET=truelode
S3_ACCESS_KEY=
S3_SECRET_KEY=

PUBLIC_BASE_URL=http://localhost:3000
# Frontend base used to build Payonify return URLs
WEB_BASE_URL=http://localhost:3001

# --- Billing -----------------------------------------------------------------
BILLING_CURRENCY=USD
PER_BATCH_FEE_USD=5.0       # ENTERPRISE pay-as-you-go, charged per batch created
SEAT_FEE_USD=10.0           # ENTERPRISE per active staff seat / cycle
INDIVIDUAL_FLAT_USD=15.0    # INDIVIDUAL flat fee / cycle

# --- Payonify gateway (https://api.payonify.com) -----------------------------
# Use sk_test_… in test, sk_live_… in production. The placeholder *_demo keys
# enable a simulated local checkout (no live gateway) so the flow is runnable.
PAYONIFY_BASE_URL=https://api.payonify.com
PAYONIFY_SECRET_KEY=sk_test_demo
PAYONIFY_WEBHOOK_SECRET=whsec_demo
